# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Phase 2 — leave blank while IS_PAYMENTS_LIVE=false) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Feature flags ---
# When false, "Pay to Lock" only updates DB status; no real money moves.
NEXT_PUBLIC_IS_PAYMENTS_LIVE=false
# When true, pages fall back to in-memory mock data if Supabase isn't configured.
# Useful for local UI development without a Supabase project.
NEXT_PUBLIC_USE_MOCK_DATA=true
